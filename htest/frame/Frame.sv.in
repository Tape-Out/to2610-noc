// Frame 集成测试：信号经过外部的 user_io、FrameTop 到这一颗设计。
// 复位期间在 user_io[6:0] 上给设计编号；放开后与单元测试做同一件事：Flash 的模型接在 payload 上，
// 0 号结点从它取指、从串口发一个字，这里在 user_io 上把它收下来。设计的 io_*[n] 对外是 user_io[n + 7]。

module @FRAME_TOP@;

`ifndef FRAME_TEST_DESIGN_ID
  initial $error("FRAME_TEST_DESIGN_ID must be provided by the build tool");
`endif

  localparam int IO_WIDTH = 73;
  localparam int DESIGN_ID_WIDTH = 7;
  localparam logic [DESIGN_ID_WIDTH-1:0] DESIGN_ID = `FRAME_TEST_DESIGN_ID;
  localparam time HALF_PERIOD = 5ns;

  // payload 位次加上设计编号占的 7 位
  localparam int UART_RX = DESIGN_ID_WIDTH + 0;
  localparam int SPI0_MISO = DESIGN_ID_WIDTH + 1;
  localparam int FLASH_MISO = DESIGN_ID_WIDTH + 2;
  localparam int SPI1_MISO = DESIGN_ID_WIDTH + 3;
  localparam int UART_TX = DESIGN_ID_WIDTH + 4;
  localparam int FLASH_CSN = DESIGN_ID_WIDTH + 8;
  localparam int FLASH_SCLK = DESIGN_ID_WIDTH + 9;
  localparam int FLASH_MOSI = DESIGN_ID_WIDTH + 10;
  localparam int NODE_UART = DESIGN_ID_WIDTH + 54;

  // 程序把分频值写成 16；发送器每位占分频值加一拍
  localparam int BIT_CYCLES = 17;
  localparam logic [7:0] EXPECT = 8'h@EXPECT@;
  localparam int TIMEOUT_CYCLES = 600_000;

  localparam int ROM_BYTES = @ROM_BYTES@;
  localparam logic [23:0] ROM_BASE = 24'h100000;
  logic [7:0] rom [ROM_BYTES] = '{@ROM@};

  // 构建工具按 reset、test_io_oe 与 dut 这三个名字接争用检查，不要改名
  logic clock = 1'b0;
  logic reset = 1'b1;
  logic [IO_WIDTH-1:0] test_io_out = '0;
  logic [IO_WIDTH-1:0] test_io_oe = '0;
  tri [IO_WIDTH-1:0] user_io;

  always #(HALF_PERIOD) clock = ~clock;

  for (genvar io_index = 0; io_index < IO_WIDTH; io_index++) begin : gen_test_io
    assign user_io[io_index] = test_io_oe[io_index]
      ? test_io_out[io_index]
      : 1'bz;
  end

  FrameTop dut (
    .clock(clock), .reset(reset), .user_io(user_io)
  );

  // SPI Flash：只认 0x03 读
  wire flash_csn = user_io[FLASH_CSN];
  wire flash_sclk = user_io[FLASH_SCLK];
  wire flash_mosi = user_io[FLASH_MOSI];
  logic flash_miso = 1'b1;
  logic [5:0] flash_count = '0;
  logic [22:0] flash_shift = '0;
  logic [23:0] flash_addr = '0;
  logic [2:0] flash_bit = 3'd7;

  function automatic logic [7:0] flash_byte(input logic [23:0] addr);
    logic [23:0] offset;
    offset = addr - ROM_BASE;
    if (addr >= ROM_BASE && offset < 24'(ROM_BYTES)) return rom[offset[$clog2(ROM_BYTES)-1:0]];
    return 8'hff;
  endfunction

  // 在主时钟的下降沿看 SCLK：它是主时钟的二分频，这时已经稳定。比上一拍高了是上升沿，收一位；低了是下降沿，送一位
  logic flash_sclk_q = 1'b0;
  always @(negedge clock) begin
    flash_sclk_q <= (flash_sclk === 1'b1);
    if (flash_csn !== 1'b0) begin
      flash_count <= '0;
    end else if (flash_sclk === 1'b1 && !flash_sclk_q) begin
      if (flash_count < 6'd32) begin
        flash_shift <= {flash_shift[21:0], flash_mosi};
        flash_count <= flash_count + 6'd1;
        if (flash_count == 6'd31) begin
          flash_addr <= {flash_shift, flash_mosi};
          flash_bit <= 3'd7;
        end
      end else begin
        flash_bit <= flash_bit - 3'd1;
        if (flash_bit == 3'd0) flash_addr <= flash_addr + 24'd1;
      end
    end else if (flash_sclk === 1'b0 && flash_sclk_q) begin
      if (flash_count == 6'd32) flash_miso <= flash_byte(flash_addr)[flash_bit];
    end
  end

  always_comb test_io_out[FLASH_MISO] = flash_miso;

  task automatic uart_receive(output logic [7:0] data);
    @(negedge user_io[UART_TX]);
    repeat (BIT_CYCLES + BIT_CYCLES / 2) @(posedge clock);
    for (int i = 0; i < 8; i++) begin
      data[i] = user_io[UART_TX];
      repeat (BIT_CYCLES) @(posedge clock);
    end
  endtask

  initial begin
    logic [7:0] got;

    // 复位期间给设计编号；七根只进不出的脚由测试台驱动，空闲为高
    test_io_oe[DESIGN_ID_WIDTH-1:0] = '1;
    test_io_out[DESIGN_ID_WIDTH-1:0] = DESIGN_ID;
    test_io_oe[UART_RX] = 1'b1;
    test_io_out[UART_RX] = 1'b1;
    test_io_oe[SPI0_MISO] = 1'b1;
    test_io_out[SPI0_MISO] = 1'b1;
    test_io_oe[SPI1_MISO] = 1'b1;
    test_io_out[SPI1_MISO] = 1'b1;
    test_io_oe[NODE_UART+:6] = 6'b010101;
    test_io_out[NODE_UART+:6] = 6'b010101;
    test_io_oe[FLASH_MISO] = 1'b1;
    repeat (20) @(posedge clock);
    @(negedge clock);
    reset = 1'b0;
    repeat (4) @(posedge clock);
    #1ns;

    if (!dut.selection_valid || !dut.design_selected[DESIGN_ID])
      $fatal(1, "the design was not selected through FrameTop");

    fork
      begin
        uart_receive(got);
        if (got !== EXPECT) $fatal(1, "UART sent %h, expected %h", got, EXPECT);
        $display("@FRAME_TOP@ PASS: selected through FrameTop, booted from flash and sent %h", EXPECT);
        $finish;
      end
      begin
        repeat (TIMEOUT_CYCLES) @(posedge clock);
        $fatal(1, "nothing on the UART after %0d cycles", TIMEOUT_CYCLES);
      end
    join_any
  end

endmodule
