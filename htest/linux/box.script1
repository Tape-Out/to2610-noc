send \n
expect ~ #
send until [ $(($(devmem 0x40040110) & 1)) = 1 ]; do :; done; echo from=$(devmem 0x40040108) got=$(devmem 0x4004010C)\n
expect from=0x00000000 got=0x22220001
send devmem 0x90000000\n
expect 0x12345678
send devmem 0x40040100 32 3; devmem 0x40040104 32 0x55550000; echo asked=$((1+2))\n
expect asked=3
send until [ $(($(devmem 0x40040110) & 1)) = 1 ]; do :; done; echo from=$(devmem 0x40040108) got=$(devmem 0x4004010C)\n
expect from=0x00000003 got=0x55550001
send devmem 0x90000004 32 0x87654321; echo wrote=$((1+1))\n
expect wrote=2
send devmem 0x40040100 32 0; devmem 0x40040104 32 0x44440001; echo told=$((1+3))\n
expect told=4
